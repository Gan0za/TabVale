{
  "schema": 1,
  "id": "com.tabvale.weather",
  "name": "Weather",
  "version": "1.0.3",
  "apiVersion": 1,
  "minAppVersion": "1.2.0",
  "entry": "plugin.js",
  "icon": "icon.svg",
  "description": "Current weather from Open-Meteo.",
  "author": "TabVale",
  "permissions": {
    "network": [
      "https://api.open-meteo.com/*",
      "https://geocoding-api.open-meteo.com/*"
    ],
    "capabilities": [],
    "storageKB": 16
  },
  "surfaces": {
    "panel": {
      "sides": [
        "right",
        "left"
      ],
      "width": [
        300,
        460
      ],
      "height": [
        240,
        460
      ],
      "mode": [
        "overlay"
      ]
    },
    "strip": {
      "positions": [
        "top",
        "bottom"
      ],
      "height": [
        64,
        120
      ]
    },
    "rail": {
      "positions": [
        "top"
      ]
    },
    "tiles": {
      "span": [
        1,
        1
      ]
    }
  },
  "locales": {
    "ru": {
      "name": "Погода"
    },
    "en": {
      "name": "Weather"
    },
    "de": {
      "name": "Wetter"
    },
    "fr": {
      "name": "Météo"
    },
    "es": {
      "name": "Tiempo"
    },
    "pt-BR": {
      "name": "Tempo"
    },
    "it": {
      "name": "Meteo"
    },
    "pl": {
      "name": "Pogoda"
    },
    "tr": {
      "name": "Hava durumu"
    },
    "uk": {
      "name": "Погода"
    },
    "zh-CN": {
      "name": "天气"
    },
    "ja": {
      "name": "天気"
    },
    "ko": {
      "name": "날씨"
    }
  }
}
