{
  "schema": 1,
  "id": "com.tabvale.notes",
  "name": "Quick notes",
  "version": "1.0.0",
  "apiVersion": 1,
  "minAppVersion": "1.2.0",
  "entry": "plugin.js",
  "description": "A small scratchpad that saves as you type.",
  "author": "TabVale",
  "permissions": { "network": [], "capabilities": [], "storageKB": 64 },
  "surfaces": {
    "panel": { "sides": ["right", "left"], "width": [300, 520], "height": [260, 700], "mode": ["overlay"] },
    "rail": { "positions": ["top"] }
  },
  "locales": {
    "ru": { "name": "Быстрые заметки" },
    "de": { "name": "Notizen" },
    "fr": { "name": "Notes rapides" },
    "es": { "name": "Notas rápidas" }
  }
}
