{
  "schema": 1,
  "id": "com.tabvale.notes",
  "name": "Quick notes",
  "version": "1.0.1",
  "apiVersion": 1,
  "minAppVersion": "1.2.0",
  "entry": "plugin.js",
  "description": "A small scratchpad that saves as you type.",
  "author": "TabVale",
  "permissions": {
    "network": [],
    "capabilities": [],
    "storageKB": 64
  },
  "surfaces": {
    "panel": {
      "sides": [
        "right",
        "left"
      ],
      "width": [
        300,
        520
