{
  "schema": 1,
  "id": "com.tabvale.layout",
  "name": "Layout converter",
  "version": "1.0.0",
  "apiVersion": 1,
  "minAppVersion": "1.2.0",
  "entry": "plugin.js",
  "description": "Converts text typed in the wrong keyboard layout.",
  "author": "TabVale",
  "permissions": { "network": [], "capabilities": [], "storageKB": 16 },
  "surfaces": {
    "panel": { "sides": ["right", "left"], "width": [320, 520], "height": [260, 600], "mode": ["overlay"] },
    "rail": { "positions": ["top"] }
  },
  "locales": {
    "ru": { "name": "Конвертер раскладок" },
    "de": { "name": "Tastaturlayout" },
    "fr": { "name": "Convertisseur" },
    "es": { "name": "Convertidor" }
  }
}
