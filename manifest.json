{
  "manifest_version": 3,
  "name": "Custom New Tab",
  "description": "Новая вкладка с поиском, закладками и сменой фона",
  "version": "1.0.0",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://*/*",
    "http://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "chrome_url_overrides": {
    "newtab": "newtab/index.html"
  },
  "icons": {
    "16": "assets/icons/favicon.svg",
    "48": "assets/icons/favicon.svg",
    "128": "assets/icons/favicon.svg"
  },
  "action": {
    "default_title": "Custom New Tab"
  }
}